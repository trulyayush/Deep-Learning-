# GEMINI_API_KEY: Required for Gemini multimodal AI inference calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional external Python FastAPI GPU inference server URL
EXTERNAL_INFERENCE_URL=""

# Optional PostgreSQL / Supabase connection settings for external deployment
DATABASE_URL=""
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Maximum upload file size in megabytes (default: 100)
MAX_UPLOAD_MB="100"
